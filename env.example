# Copy to `env` (git-ignored) and fill in. None of these values are secret,
# but they identify your Okta org, so keep `env` out of version control.
OKTA_ORG_URL="https://your-org.okta.com"   # no "-admin" in the hostname
OKTA_CLIENT_ID="your-client-id"
OKTA_KEY_ID="your-key-id"

# 1Password secret reference to the PEM private key (e.g. a Secure Note's body).
OKTA_PRIVATE_KEY_REF="op://dev/Okta developer MCP key/notesPlain"

# Space-separated; every scope must be granted to the app in Okta or auth fails.
# Read access for investigations, plus user and group administration. Add more only when needed.
OKTA_SCOPES="okta.users.read okta.groups.read okta.apps.read okta.logs.read okta.policies.read okta.users.manage okta.groups.manage"

# OKTA_LOG_LEVEL="DEBUG"
# OKTA_LOG_FILE="$HOME/code/okta-mcp-local/okta-mcp.log"
